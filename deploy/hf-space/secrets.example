# Copy to .space-secrets (gitignored) and fill in. `make space-push` sends these to the
# Space as encrypted secrets, which are visible to the container only, never in the repo.
GROQ_API_KEY=
# Required: the app listens on 0.0.0.0 inside the Space. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
UI_PASSWORD=
