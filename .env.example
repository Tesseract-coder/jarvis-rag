# Copy to .env and edit. Every value here has a default in jarvis_rag/config.py.

# --- Persona -----------------------------------------------------------------
AGENT_NAME=JARVIS
# How JARVIS addresses you, e.g. "sir". Empty = no honorific.
ADDRESS_USER_AS=

# --- Providers (Phase 7 adds groq | gemini | openrouter / fastembed) ---------
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama

# --- Ollama -----------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Instruct variant: no thinking mode. Plain "qwen3:4b" is Qwen3-4B-Thinking-2507,
# which always reasons and leaks it into the answer even with think=false.
CHAT_MODEL=qwen3:4b-instruct
FALLBACK_CHAT_MODEL=qwen3:1.7b
EMBED_MODEL=nomic-embed-text

# Context window (tokens). KV cache grows linearly with this; 8192 fits a 4GB GPU.
NUM_CTX=8192
# Layers offloaded to GPU. 99 = all. "auto" = let Ollama decide (it keeps a 1GiB
# safety margin, which on a 4GB card pushes ~15% of layers to CPU and costs ~40% speed).
NUM_GPU=99
# Embedding model runs on CPU (0 GPU layers) so it never evicts the chat model from VRAM.
EMBED_NUM_GPU=0
TEMPERATURE=0.2
# Qwen3 hybrid models (e.g. qwen3:1.7b) honour this; keep off for agents.
REASONING=false
# Seconds Ollama keeps a model loaded after the last request.
KEEP_ALIVE=1800
# nomic-embed-text was trained with task prefixes; leave empty for models that weren't.
# Changing the embedding model or prefixes means re-ingesting (different vector space).
EMBED_QUERY_PREFIX="search_query: "
EMBED_DOCUMENT_PREFIX="search_document: "

# --- Chunking ---------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CODE_CHUNK_SIZE=1200
CODE_CHUNK_OVERLAP=150

# --- Retrieval --------------------------------------------------------------
# similarity | mmr | hybrid (BM25 + vector) | rerank (hybrid + cross-encoder).
# Measure before changing: `make eval` prints hit@k / MRR for every mode.
# rerank falls back to hybrid if the reranker model can't be loaded (e.g. offline).
RETRIEVAL_MODE=rerank
RETRIEVAL_K=5
FETCH_K=20
MMR_LAMBDA=0.5
BM25_WEIGHT=0.5
# Cross-encoder for RETRIEVAL_MODE=rerank (FastEmbed ONNX, CPU, ~80 MB, cached in storage/models).
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Vector store + ingestion ----------------------------------------------
COLLECTION_NAME=jarvis
# Files bigger than this are skipped (MB).
MAX_FILE_MB=20
# Upper bound on pages fetched by one --url crawl.
URL_MAX_PAGES=25

# --- Agent (Phase 4) ---------------------------------------------------------
# sqlite = conversations survive restarts (storage/memory.db); memory = forgotten on exit.
MEMORY_BACKEND=sqlite
# Search the knowledge base before every turn. Small models often answer from memory
# instead of searching; `make eval-agent`: 10/19 without this, 18/19 with it.
AUTO_SEARCH=true
# Max model calls per question (each tool round = one call). Stops tool loops.
AGENT_MAX_MODEL_CALLS=8
# Older turns beyond this many tokens are left out of the prompt (still saved).
HISTORY_MAX_TOKENS=3000
TOOL_OUTPUT_MAX_CHARS=4000
SQL_MAX_ROWS=200
SQL_TIMEOUT_S=5
# Let the agent save notes into the knowledge base when you ask it to.
ALLOW_INGEST_TOOL=false
# Let fetch_url reach localhost / private network addresses (off: SSRF protection).
FETCH_ALLOW_PRIVATE=false

# --- HTTP API (Phase 5) -------------------------------------------------------
# 127.0.0.1 = this machine only. 0.0.0.0 = your whole network: the server refuses
# to start that way without API_KEY.
API_HOST=127.0.0.1
API_PORT=8000
# Clients send it as the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Browser origins allowed to call the API (comma-separated). 7860 = Gradio (Phase 6).
CORS_ORIGINS=http://localhost:7860,http://127.0.0.1:7860,http://localhost:3000
MAX_MESSAGE_CHARS=4000
MAX_CRAWL_DEPTH=2

# --- Paths ------------------------------------------------------------------
DATA_DIR=data
STORAGE_DIR=storage
